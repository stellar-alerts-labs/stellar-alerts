DATABASE_URL="postgresql://user:password@localhost:5432/stellar_alerts?schema=public"
READ_REPLICA_URL="postgresql://user:password@replica-host:5432/stellar_alerts?schema=public"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
JWT_SECRET="super-secret-j{t-key"
REDIS_URL="redis://localhost:6379"
# Twilio WhatsApp alert delivery. TWILIO_WHATSAPP_FROM must be a WhatsApp-enabled
# Twilio sender number in E.164 format (no "whatsapp:" prefix). Leave unset to
# disable WhatsApp dispatch; alerts for opted-in users are then skipped and logged.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="+14155238886"
# Optional Meta WhatsApp Cloud API interactive configuration controls. The
# webhook URL is https://<api-host>/notifications/whatsapp/webhook.
WHATSAPP_ACCESS_TOKEN="your-meta-whatsapp-access-token"
WHATSAPP_PHONE_NUMBER_ID="your-meta-phone-number-id"
WHATSAPP_APP_SECRET="your-meta-app-secret"
WHATSAPP_WEBHOOK_VERIFY_TOKEN="generate-a-random-webhook-verification-token"
# Optional Graph API version override (default: v23.0).
WHATSAPP_GRAPH_API_VERSION="v23.0"

MASTER_ENCRYPTION_KEY="generate-a-random-32+character-secret"
MASTER_ENCRYPTION_KEY_VERSION="1"
MASTER_ENCRYPTION_OLD_KEYS="{}"
# Discord interactions endpoint. Copy the application public key from
# Discord Developer Portal -> Applications -> General Information.
# Leave unset to disable /integrations/discord/interactions.
DISCORD_PUBLIC_KEY=""

# Structured Pino logging (API + workers)
LOG_LEVEL="info"
SERVICE_NAME="stellar-alerts"

# Slack slash commands (/stellar balance, /stellar alerts). Copy the signing
# secret from Slack App -> Basic Information -> Signing Secret.
# Leave unset to disable POST /slack/commands (responds 503, fail-closed).
SLACK_SIGNING_SECRET=""
# Pre-execution simulation engine (POST /simulations/analyze).
# Every threshold is optional and defaults to the value shown, so an unset
# variable is not an error. See docs/simulation.md for what each one gates.
# SIMULATION_NEAR_TOTAL_OUTFLOW_RATIO="0.85"
# SIMULATION_FAN_OUT_DESTINATION_THRESHOLD="3"
# SIMULATION_SEQUENTIAL_TRANSFER_THRESHOLD="8"
# SIMULATION_MAX_FOOTPRINT_READ_WRITE_KEYS="64"
# SIMULATION_FOOTPRINT_PROBE_CONTRACT_THRESHOLD="5"
# SIMULATION_MAX_INVOCATIONS_PER_CONTRACT="5"
# SIMULATION_RISK_BLOCK_THRESHOLD="80"
# SIMULATION_DUST_AMOUNT_STROOPS="10"
