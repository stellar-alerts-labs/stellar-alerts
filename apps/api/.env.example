DATABASE_URL="postgresql://user:password@localhost:5432/stellar_alerts?schema=public"
READ_REPLICA_URL="postgresql://user:password@replica-host:5432/stellar_alerts?schema=public"
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"
JWT_SECRET="super-secret-j{t-key"
REDIS_URL="redis://localhost:6379"
# Optional: base URL used to mint DID login challenges (defaults to the API host)
DID_CHALLENGE_TTL_SECONDS="300"

# Twilio WhatsApp alert delivery. TWILIO_WHATSAPP_FROM must be a WhatsApp-enabled
# Twilio sender number in E.164 format (no "whatsapp:" prefix). Leave unset to
# disable WhatsApp dispatch; alerts for opted-in users are then skipped and logged.
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_WHATSAPP_FROM="+14155238886"

MASTER_ENCRYPTION_KEY="generate-a-random-32+character-secret"
MASTER_ENCRYPTION_KEY_VERSION="1"
MASTER_ENCRYPTION_OLD_KEYS="{}"

# Asynchronous export jobs (see docs/exports.md). All optional; defaults shown.
# EXPORT_WORKER_ENABLED="false" runs exports inside the API process instead of
# the export worker (npm run dev:exports / supervisor).
EXPORT_WORKER_ENABLED="true"
# Must be shared by the API and export worker; empty = <os tmpdir>/stellar-alerts-exports
EXPORT_STORAGE_DIR=""
EXPORT_TTL_SECONDS="86400"
EXPORT_DOWNLOAD_URL_TTL_SECONDS="300"
EXPORT_MAX_ROWS="100000"
EXPORT_BATCH_SIZE="500"
EXPORT_MAX_ACTIVE_JOBS_PER_USER="3"
EXPORT_WORKER_CONCURRENCY="2"
EXPORT_CLEANUP_INTERVAL_MS="600000"
EXPORT_STALE_JOB_MS="1800000"
