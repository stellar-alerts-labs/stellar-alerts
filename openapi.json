{
  "openapi": "3.0.3",
  "info": {
    "title": "Stellar Alerts API",
    "description": "Interactive API documentation for the Stellar Payment Tracker. Register wallets, monitor payments and manage webhook alert endpoints.",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "RequestLinkInput": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          }
        },
        "required": [
          "email"
        ],
        "additionalProperties": false
      },
      "VerifyLinkInput": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "DIDChallengeInput": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        },
        "required": [
          "did"
        ],
        "additionalProperties": false
      },
      "DIDVerifyInput": {
        "type": "object",
        "properties": {
          "did": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "challenge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "signature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": [
          "did",
          "challenge",
          "signature"
        ],
        "additionalProperties": false
      },
      "CreateWalletInput": {
        "type": "object",
        "properties": {
          "publicKey": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "zkProof": {},
          "publicSignals": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "publicKey"
        ],
        "additionalProperties": false
      },
      "CreateWebhookInput": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "format": "uri"
          },
          "payloadTemplate": {
            "type": "string",
            "maxLength": 16384
          }
        },
        "required": [
          "url"
        ],
        "additionalProperties": false
      },
      "DeadLetterIdParams": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ListDeadLettersQuery": {
        "type": "object",
        "properties": {
          "channel": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "retried",
              "suppressed"
            ]
          },
          "q": {
            "type": "string",
            "maxLength": 200
          },
          "maxAgeDays": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "pageSize": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "page",
          "pageSize"
        ],
        "additionalProperties": false
      },
      "SuppressDeadLetterInput": {
        "type": "object",
        "properties": {
          "note": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "additionalProperties": false
      },
      "CreateExportInput": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "ledger_csv",
              "ledger_pdf",
              "tax_csv"
            ]
          },
          "walletId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "periodStart": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "periodEnd": {
            "anyOf": [
              {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
              }
            ]
          },
          "format": {
            "type": "string",
            "enum": [
              "cointracker",
              "koinly",
              "irs8949"
            ]
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      },
      "ExportIdParams": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ListExportsQuery": {
        "type": "object",
        "properties": {
          "page": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "pageSize": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          }
        },
        "required": [
          "page",
          "pageSize"
        ],
        "additionalProperties": false
      },
      "DownloadExportQuery": {
        "type": "object",
        "properties": {
          "expires": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "sig": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "required": [
          "expires",
          "sig"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {},
  "tags": [
    {
      "name": "auth",
      "description": "Magic-link authentication"
    },
    {
      "name": "wallets",
      "description": "Watched Stellar wallet management"
    },
    {
      "name": "payments",
      "description": "Incoming payment history and summaries"
    },
    {
      "name": "webhooks",
      "description": "Custom webhook alert endpoint management"
    },
    {
      "name": "dead-letters",
      "description": "Inspection, replay and suppression of failed notification deliveries"
    },
    {
      "name": "exports",
      "description": "Asynchronous CSV/PDF export jobs with progress and signed downloads"
    }
  ]
}
